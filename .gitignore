# Mobile app (mobile/): native projects are generated by expo prebuild (Continuous Native Generation), never
# committed. QA screenshots stay local. Firebase config and signing material never enter Git.
mobile/ios/
mobile/android/
mobile/.expo/
mobile/qa/
mobile/google-services.json
mobile/*.jks
mobile/*.keystore
mobile/*.p8
mobile/**/private-key*.pem
