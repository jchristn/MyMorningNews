{
  "uid": "mmn-auth",
  "title": "My Morning News: Auth and security",
  "description": "Authentication by scheme and result, authorization denials, sessions, RBAC changes, and rate limiting.",
  "tags": [
    "mymorningnews"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"mymorningnews-server\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"mymorningnews-server\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "My Morning News",
      "type": "dashboards",
      "tags": [
        "mymorningnews"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Sign-in failures",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mymorningnews_auth_requests_total{job=\"mymorningnews-server\",instance=~\"$instance\",scheme=\"login\",result!=\"Success\"}[$__range]))",
          "instant": true
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Rate-limited logins",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_request_duration_seconds_count{job=\"mymorningnews-server\",instance=~\"$instance\",http_route=~\"/v1.0/token.*\",http_response_status_code=\"429\"}[$__range]))",
          "instant": true
        }
      ],
      "id": 2,
      "description": "429 responses from /v1.0/token. The auth counter records these as Invalid, so they are counted from the HTTP layer."
    },
