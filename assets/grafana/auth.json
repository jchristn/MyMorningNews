    },
    {
      "type": "stat",
      "title": "Bad credentials ratio",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(mymorningnews_auth_requests_total{job=\"mymorningnews-server\",instance=~\"$instance\",result=~\"Invalid|NotFound|Inactive\"}[$__range]))) / clamp_min(sum(increase(mymorningnews_auth_requests_total{job=\"mymorningnews-server\",instance=~\"$instance\",result!=\"NotAttempted\"}[$__range])), 1e-9)",
          "instant": true
        }
      ],
      "id": 4
    },
