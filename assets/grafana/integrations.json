{
  "uid": "mmn-integrations",
  "title": "My Morning News: Integrations",
  "description": "Search providers, page fetches and CrawlSharp, model provider HTTP, PostgreSQL (Npgsql), and push.",
  "tags": [
    "mymorningnews"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"mymorningnews-server\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"mymorningnews-server\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "My Morning News",
      "type": "dashboards",
      "tags": [
        "mymorningnews"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Search error ratio",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(mymorningnews_search_requests_total{job=\"mymorningnews-server\",instance=~\"$instance\",outcome=\"error\"}[$__range]))) / clamp_min(sum(increase(mymorningnews_search_requests_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[$__range])), 1e-9)",
          "instant": true
        }
      ],
      "id": 1
