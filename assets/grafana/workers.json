        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mymorningnews_worker_iterations_total{job=\"mymorningnews-server\",instance=~\"$instance\",outcome=\"error\"}[$__range]))",
