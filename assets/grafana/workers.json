      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(mymorningnews_worker_iterations_total{job=\"mymorningnews-server\",instance=~\"$instance\",outcome=\"error\"}[$__range]))) / clamp_min(sum(increase(mymorningnews_worker_iterations_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[$__range])), 1e-9)",
          "instant": true
        }
      ],
      "id": 3
