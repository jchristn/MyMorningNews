# My Morning News Docker environment. Copy to `.env` in this folder and edit before `docker compose up`.
# docker compose reads `.env` automatically and substitutes ${VAR} in compose.yaml. Every value can also be set
# in docker/server/mymorningnews.json; environment variables win and are never written back to that file.
#
# These are LOCAL DEVELOPMENT DEFAULTS. Change every secret below before any shared or hosted deployment.
# Default sign-in for a new install: admin@mymorningnews / password (tenant "default"). Change the password after
# your first sign-in.

# --- Models ----------------------------------------------------------------------------------------------------
# Anthropic API key for the default chat model (claude-opus-5-5). Stored in the default tenant's vault on first boot
# and checked on the dashboard's Setup page. Leave blank to paste the key on the Setup page instead.
MYMORNINGNEWS_ANTHROPIC_API_KEY=
# Ollama URL for the seeded embedding endpoint (all-minilm). macOS: Ollama on the host. Linux with --profile ollama:
# http://ollama:11434
MYMORNINGNEWS_OLLAMA_ENDPOINT=http://host.docker.internal:11434

# --- Agent CLIs in the server image (optional) ------------------------------------------------------------------
# The server image includes Claude Code (claude), Codex (codex), Gemini CLI (gemini), and Mux (mux). Each workspace
# connects them on its Setup page with a subscription sign-in (a claude setup-token token, the auth.json from
# codex login, Gemini CLI's oauth_creds.json, or Mux's endpoints.json) or an API key. Those secrets live encrypted
# in the workspace vault, and each endpoint runs with its own home folder in the clihome volume.
#
# The keys below are used only by the "Already signed in on the server" method, which runs the CLI with the
# server's own sign-in, shared by every workspace that picks it. They reach the CLIs as ANTHROPIC_API_KEY,
# OPENAI_API_KEY, and GEMINI_API_KEY. Leave them blank to sign in interactively instead
# (docker exec -it mymorningnews-server claude); that sign-in persists in the clihome volume.
CLI_ANTHROPIC_API_KEY=
CLI_OPENAI_API_KEY=
CLI_GEMINI_API_KEY=
# Whether model endpoints may run these CLIs at all. Set false on a shared server: the CLIs run as the server's own
# user, and any workspace administrator could pick the server's sign-in. The Setup page then lists the CLIs as
# unavailable. The hosted overlay sets false.
MYMORNINGNEWS_MODELS_ALLOW_AGENT_CLIS=true
# Limit connecting agent CLIs to global administrators (the hosted profiles turn this on).
MYMORNINGNEWS_MODELS_AGENT_CLIS_ADMINS_ONLY=false

# --- Security --------------------------------------------------------------------------------------------------
# Key that encrypts session tokens and stored secrets. Changing it signs everyone out and makes existing vault
# secrets unreadable, so set it once.
MYMORNINGNEWS_AUTH_SIGNING_KEY=mymorningnews-change-this-signing-key
# System administration key (x-api-key header). Empty disables it.
MYMORNINGNEWS_AUTH_ADMIN_API_KEY=mymorningnewsadmin
# SearXNG's own secret.
MYMORNINGNEWS_SEARXNG_SECRET=mymorningnews-change-this-searxng-secret

# --- Artifact storage (briefing Markdown and HTML, audio, exports) ------------------------------------------------
# Local (the "media" Docker volume) or S3 (Amazon S3 or an S3-compatible service such as MinIO or Cloudflare R2).
MYMORNINGNEWS_STORAGE_PROVIDER=Local
MYMORNINGNEWS_STORAGE_S3_BUCKET=
MYMORNINGNEWS_STORAGE_S3_REGION=us-west-2
# Leave empty for AWS. For S3-compatible services set the endpoint URL.
MYMORNINGNEWS_STORAGE_S3_ENDPOINT=
# Leave both empty to use the default AWS credential chain (instance role, environment, or profile).
MYMORNINGNEWS_STORAGE_S3_ACCESS_KEY=
MYMORNINGNEWS_STORAGE_S3_SECRET_KEY=
MYMORNINGNEWS_STORAGE_S3_PREFIX=mymorningnews/
# Days reports and audio are kept (1 to 365).
MYMORNINGNEWS_STORAGE_ARTIFACT_RETENTION_DAYS=365

# --- Administrator summary ----------------------------------------------------------------------------------------
# Daily summary recipients come from adminReports.recipients in the settings JSON (default hello@latticetech.ai).
# Uncomment to override them here, comma-separated.
# MYMORNINGNEWS_ADMIN_REPORT_RECIPIENTS=hello@latticetech.ai,ops@example.com

# --- Mobile push ------------------------------------------------------------------------------------------------
# Expo access token, needed only if the Expo project enforces authenticated push.
MYMORNINGNEWS_PUSH_EXPO_ACCESS_TOKEN=

# Audio (plan section 22). Set to false to run without the Kokoro text-to-speech container.
MYMORNINGNEWS_TTS_ENABLED=true

# Public addresses used in podcast feeds, email links, and deep links. Change these when the server is reachable
# from other devices (for example a podcast app on your phone needs a URL it can reach).
MYMORNINGNEWS_PUBLIC_BASE_URL=http://127.0.0.1:12100
MYMORNINGNEWS_APP_BASE_URL=http://127.0.0.1:12101

# Email (plan section 23). File writes each email to the emailout volume (docker compose exec server ls /data/email);
# switch to Mailgun once the sending domain is verified.
MYMORNINGNEWS_EMAIL_PROVIDER=File
MYMORNINGNEWS_EMAIL_FROM_ADDRESS=no-reply@mymorningnews.ai
MYMORNINGNEWS_MAILGUN_DOMAIN=
MYMORNINGNEWS_MAILGUN_API_KEY=
MYMORNINGNEWS_MAILGUN_BASE_URL=https://api.mailgun.net/v3/

# Hosted service only (docker/hosted overlay, docs/HOSTING.md). Set the public addresses above to
# https://app.mymorningnews.ai when hosting. Turnstile is optional: leave both keys empty to skip the human check.
# The Apple Team ID turns on iOS universal links (/.well-known/apple-app-site-association).
MYMORNINGNEWS_APP_DOMAIN=app.mymorningnews.ai
MYMORNINGNEWS_ACME_EMAIL=hello@latticetech.ai
MYMORNINGNEWS_HOSTING_TURNSTILE_SITE_KEY=
MYMORNINGNEWS_HOSTING_TURNSTILE_SECRET_KEY=
MYMORNINGNEWS_HOSTING_APPLE_TEAM_ID=
# Play App Signing SHA-256 certificate fingerprint(s), comma-separated (Play Console, Setup, App signing). Turns on
# Android app links. Until each value is set, its /.well-known/ file answers 404 NotConfigured.
MYMORNINGNEWS_HOSTING_ANDROID_CERT_FINGERPRINTS=
# MCP server on the hosted origin: set COMPOSE_PROFILES=mcp and MYMORNINGNEWS_MCP_ON_PUBLIC_BASE_URL=true, and the app
# shows <MYMORNINGNEWS_PUBLIC_BASE_URL>/mcp. To publish a different address, set MYMORNINGNEWS_MCP_PUBLIC_URL instead.
# With neither, a public server publishes no MCP address.
# COMPOSE_PROFILES=mcp
MYMORNINGNEWS_MCP_ON_PUBLIC_BASE_URL=false
MYMORNINGNEWS_MCP_PUBLIC_URL=
