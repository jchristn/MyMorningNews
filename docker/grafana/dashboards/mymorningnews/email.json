      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (rate(mymorningnews_email_feedback_clicks_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{action}}"
        }
      ],
      "id": 13,
      "description": "open:<action> is a page view of a tokenized link; submit:<action> is the posted answer."
    },
    {
      "type": "timeseries",
      "title": "Feedback link use by target type (per hour)",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
