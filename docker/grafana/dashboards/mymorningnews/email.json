          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (targettype) (rate(mymorningnews_email_feedback_clicks_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{targettype}}"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Public feedback and unsubscribe requests by status (per hour)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"mymorningnews-server\",instance=~\"$instance\",http_route=~\"/v1.0/public/(feedback|unsubscribe).*\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{http_route}} {{http_response_status_code}}"
        }
      ],
      "id": 15,
      "description": "429 here means the public page rate limit tripped."
    },
    {
      "type": "timeseries",
      "title": "Email feedback submissions (per hour)",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
