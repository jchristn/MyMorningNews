{
  "uid": "mmn-overview",
  "title": "My Morning News: Overview",
  "tags": [
    "mymorningnews"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Server up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(watson_server_up{job=\"mymorningnews-server\",instance=~\"$instance\"})"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(watson_server_uptime_seconds{job=\"mymorningnews-server\",instance=~\"$instance\"})"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Request rate",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"mymorningnews-server\",instance=~\"$instance\"}[5m]))"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Error ratio (5xx)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"mymorningnews-server\",instance=~\"$instance\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"mymorningnews-server\",instance=~\"$instance\"}[5m])), 1e-9)"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests by status class",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (label_replace(rate(http_server_request_duration_seconds_count{job=\"mymorningnews-server\",instance=~\"$instance\"}[5m]), \"class\", \"${1}xx\", \"http_response_status_code\", \"(.)..\"))",
          "legendFormat": "{{class}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Authentication outcomes",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scheme, result) (rate(mymorningnews_auth_requests_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{scheme}} {{result}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Authorization outcomes",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(mymorningnews_authz_requests_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Working set",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(dotnet_process_memory_working_set_bytes{job=\"mymorningnews-server\",instance=~\"$instance\"})",
          "legendFormat": "working set"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Request history capture",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(mymorningnews_request_history_captures_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Worker iterations",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker, outcome) (increase(mymorningnews_worker_iterations_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[1h]))",
          "legendFormat": "{{worker}} {{outcome}}"
        }
      ],
      "id": 10
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"mymorningnews-server\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"mymorningnews-server\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "My Morning News",
      "type": "dashboards",
      "tags": [
        "mymorningnews"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "graphTooltip": 1
}
