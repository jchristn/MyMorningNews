{
  "uid": "mmn-research",
  "title": "My Morning News: Research pipeline",
  "description": "Research runs, per-stage latency, findings by tier, quote verification, and the scheduler.",
  "tags": [
    "mymorningnews"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"mymorningnews-server\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"mymorningnews-server\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "My Morning News",
      "type": "dashboards",
      "tags": [
        "mymorningnews"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Runs completed",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mymorningnews_runs_total{job=\"mymorningnews-server\",instance=~\"$instance\",outcome=\"completed\"}[$__range]))",
          "instant": true
        }
      ],
      "id": 1,
      "description": "Runs that finished in the selected range."
    },
    {
      "type": "stat",
      "title": "Run failure ratio",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(mymorningnews_runs_total{job=\"mymorningnews-server\",instance=~\"$instance\",outcome=\"failed\"}[$__range]))) / clamp_min(sum(increase(mymorningnews_runs_total{job=\"mymorningnews-server\",instance=~\"$instance\"}[$__range])), 1e-9)",
          "instant": true
        }
      ],
      "id": 2
    },
