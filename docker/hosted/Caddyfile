# Caddy for the hosted service: automatic HTTPS, API and dashboard on one origin.
{
	email {$MYMORNINGNEWS_ACME_EMAIL}
	admin 127.0.0.1:2019
}

{$MYMORNINGNEWS_APP_DOMAIN} {
	encode zstd gzip

	# API, OpenAPI, Swagger, public email and feed pages.
	@api path /v1.0/* /openapi.json /swagger*
	handle @api {
		reverse_proxy server:8000
	}

	# Universal link files for the mobile app (served by the server; plan section 33.3).
	handle /.well-known/* {
		reverse_proxy server:8000
	}

	# MCP server (Streamable HTTP), when the mcp compose profile is on (COMPOSE_PROFILES=mcp). Responses stream, so
	# nothing is buffered. Without the profile there is no mcp container and these paths answer 502. The dashboard's
	# own MCP page is /dashboard/mcp, so nothing else uses this path.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy mcp:8100 {
			flush_interval -1
		}
	}

	# Everything else is the dashboard.
	handle {
		reverse_proxy dashboard:80
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
