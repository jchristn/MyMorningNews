{
  "name": "mymorningnews-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0-alpha",
  "private": true,
  "license": "MIT",
  "description": "My Morning News mobile app: briefings, audio, topics, and insights on iPhone, iPad, and Android phones and tablets.",
  "scripts": {
    "start": "expo start --port 12191",
    "ios": "expo start --ios --port 12191",
    "android": "expo start --android --port 12191",
    "run:ios": "expo run:ios --port 12191",
    "run:android": "expo run:android --port 12191",
    "lint": "eslint . --max-warnings 0 && npm run lint:shared",
    "lint:shared": "node scripts/lint-shared.js",
    "test": "jest",
    "test:ci": "jest --ci",
    "i18n:check": "jest --ci src/__tests__/i18n.test.js",
    "parity:check": "node scripts/parity.js",
    "parity:strict": "node scripts/parity.js --strict",
    "audit:check": "node scripts/check-audit.js",
    "export:check": "expo export --platform ios --platform android --output-dir dist",
    "assets": "node scripts/generate-assets.js",
    "assets:tone": "node scripts/generate-test-tone.js",
    "updates-certificate": "node scripts/generate-updates-certificate.js",
    "publish-update": "node scripts/publish-update.js",
    "verify": "npm run lint && npm run i18n:check && npm run parity:check && npm run audit:check && npm run test:ci && npm run export:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@formatjs/intl-getcanonicallocales": "^3.4.0",
    "@formatjs/intl-locale": "^5.5.0",
    "@formatjs/intl-pluralrules": "^7.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-iap": "6.5.1",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "58.0.22",
    "expo-web-browser": "58.0.8",
    "i18next": "^27.1.5",
    "i18next-icu": "^2.7.1",
    "intl-messageformat": "^12.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "jimp-compact": "0.16.1"
  }
}
