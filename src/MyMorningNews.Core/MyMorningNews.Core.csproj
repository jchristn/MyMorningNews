<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>MyMorningNews.Core</RootNamespace>
    <Description>Core library for My Morning News: models, database, services, research pipeline, and email.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.3" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="CrawlSharp" Version="1.2.3" />
    <PackageReference Include="DocConverter" Version="0.1.3" />
    <PackageReference Include="HtmlPageBuilder" Version="1.2.1" />
    <PackageReference Include="Mux.Search" Version="1.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="PolyPrompt" Version="5.0.1" />
    <PackageReference Include="PrettyId" Version="2.0.3" />
    <PackageReference Include="SendWithMailgun" Version="1.2.2" />
    <PackageReference Include="SyslogLogging" Version="2.4.2" />
    <PackageReference Include="TextChunker" Version="0.3.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Defaults\**\*.md" />
  </ItemGroup>

</Project>
